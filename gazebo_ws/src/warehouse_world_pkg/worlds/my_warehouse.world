    <!-- === 6. CUSTOM TELEVISION DISPLAYS === -->

    <!-- 
      CUSTOM TV 1 (West Wall)
      This model is a simple box scaled 3x (approx. 4.35m wide x 2.49m high).
      We define it as a new model so we can apply a custom picture script, 
      which isn't possible when <include>-ing the 'tv_65in_emissive' model.
    -->
    <model name="custom_tv_west">
      <static>true</static>
      <!-- Placed on the inner face of the west wall (at x=-19.75), centered at y=0, z=3.0. -->
      <!-- Rotated 90 deg (1.5707 rad) to align width with global Y-axis. -->
      <!-- Back face is at x=-19.75, so model center is at x=-19.675 -->
      <pose>-19.675 0 3.0 0 0 1.5707</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <!-- Size (Local X, Y, Z) = (Width, Depth, Height) -->
            <box><size>4.35 0.15 2.49</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <!-- Size matches collision -->
            <box><size>4.35 0.15 2.49</size></box>
          </geometry>
          <material>
            <script>
              <!-- 
                *** YOUR CUSTOM IMAGE LOCATION 1 ***
                This is the "location" you asked for.
                Place your custom image (e.g., custom_west.png) 
                in a path that Gazebo can find (e.g., in a /materials/textures 
                folder relative to this world or in a custom model path).
                Then, update this URI to point to it.
                Example: file://media/materials/textures/custom_west.png
              -->
              <uri>model://warehouse_ground/materials/textures/images.png</uri>
              <name>Custom/ScreenWest</name>
            </script>
            <!-- Make the screen glow slightly so it looks active -->
            <emissive>0.5 0.5 0.5 1</emissive>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- 
      CUSTOM TV 2 (South Wall)
      This model is a simple box scaled 3x (approx. 4.35m wide x 2.49m high).
    -->
    <model name="custom_tv_south">
      <static>true</static>
      <!-- Placed on the inner face of the south wall (at y=-14.75), centered at x=0, z=3.0. -->
      <!-- No rotation needed. -->
      <!-- Back face is at y=-14.75, so model center is at y=-14.675 -->
      <pose>0 -14.675 3.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <!-- Size (Local X, Y, Z) = (Width, Depth, Height) -->
