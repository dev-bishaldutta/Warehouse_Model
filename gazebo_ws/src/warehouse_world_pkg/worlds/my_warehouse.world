<?xml version="1.0"?>
<sdf version="1.10">
  <world name="Advanced_Robotic_Warehouse_v7">

    <!-- 
      =========================================================================
      === UPDATED WORLD: V7 - Added Custom TV Displays ========================
      =========================================================================
      * Added two large (3x 65in scale) TV display models to the west and 
        south walls.
      * These are defined as new models (not <include>) to allow for
        custom texture scripts, as requested.
      * See comments at the end of the file for custom image paths.
      =========================================================================
    -->

    <!-- === 1. CORE SIMULATION & SCENE SETUP === -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin name='gz::sim::systems::Physics' filename='gz-sim-physics-system'/>
    <plugin name='gz::sim::systems::UserCommands' filename='gz-sim-user-commands-system'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='gz-sim-scene-broadcaster-system'/>
    <plugin name='gz::sim::systems::Contact' filename='gz-sim-contact-system'/>
    <plugin name='gz::sim::systems::Sensors' filename='gz-sim-sensors-system'>
      <render_engine>ogre2</render_engine>
    </plugin>
    <gravity>0 0 -9.8</gravity>
    <atmosphere type='adiabatic'/>
    
    <!-- === 2. SCENE & LIGHTING === -->
    <scene>
      <ambient>0.4 0.4 0.4 1.0</ambient>
      <background>0.5 0.5 0.5 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
      <origin_visual>false</origin_visual>
    </scene>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Sky</uri>
    </include>
    
    <!-- Distributed overhead lights -->
    <light type="point" name="light_1_1"><pose>-15 10 8 0 0 0</pose><diffuse>0.8 0.8 0.7 1</diffuse><specular>0.1 0.1 0.1 1</specular><attenuation><range>30</range><linear>0.01</linear><constant>0.2</constant><quadratic>0.002</quadratic></attenuation><cast_shadows>false</cast_shadows></light>
    <light type="point" name="light_1_2"><pose>0 10 8 0 0 0</pose><diffuse>0.8 0.8 0.7 1</diffuse><specular>0.1 0.1 0.1 1</specular><attenuation><range>30</range><linear>0.01</linear><constant>0.2</constant><quadratic>0.002</quadratic></attenuation><cast_shadows>false</cast_shadows></light>
    <light type="point" name="light_1_3"><pose>15 10 8 0 0 0</pose><diffuse>0.8 0.8 0.7 1</diffuse><specular>0.1 0.1 0.1 1</specular><attenuation><range>30</range><linear>0.01</linear><constant>0.2</constant><quadratic>0.002</quadratic></attenuation><cast_shadows>false</cast_shadows></light>
    <light type="point" name="light_2_1"><pose>-15 0 8 0 0 0</pose><diffuse>0.8 0.8 0.7 1</diffuse><specular>0.1 0.1 0.1 1</specular><attenuation><range>30</range><linear>0.01</linear><constant>0.2</constant><quadratic>0.002</quadratic></attenuation><cast_shadows>false</cast_shadows></light>
    <light type="point" name="light_2_2"><pose>0 0 8 0 0 0</pose><diffuse>0.8 0.8 0.7 1</diffuse><specular>0.1 0.1 0.1 1</specular><attenuation><range>30</range><linear>0.01</linear><constant>0.2</constant><quadratic>0.002</quadratic></attenuation><cast_shadows>false</cast_shadows></light>
    <light type="point" name="light_2_3"><pose>15 0 8 0 0 0</pose><diffuse>0.8 0.8 0.7 1</diffuse><specular>0.1 0.1 0.1 1</specular><attenuation><range>30</range><linear>0.01</linear><constant>0.2</constant><quadratic>0.002</quadratic></attenuation><cast_shadows>false</cast_shadows></light>
    <light type="point" name="light_3_1"><pose>-15 -10 8 0 0 0</pose><diffuse>0.8 0.8 0.7 1</diffuse><specular>0.1 0.1 0.1 1</specular><attenuation><range>30</range><linear>0.01</linear><constant>0.2</constant><quadratic>0.002</quadratic></attenuation><cast_shadows>false</cast_shadows></light>
    <light type="point" name="light_3_2"><pose>0 -10 8 0 0 0</pose><diffuse>0.8 0.8 0.7 1</diffuse><specular>0.1 0.1 0.1 1</specular><attenuation><range>30</range><linear>0.01</linear><constant>0.2</constant><quadratic>0.002</quadratic></attenuation><cast_shadows>false</cast_shadows></light>
    <light type="point" name="light_3_3"><pose>15 -10 8 0 0 0</pose><diffuse>0.8 0.8 0.7 1</diffuse><specular>0.1 0.1 0.1 1</specular><attenuation><range>30</range><linear>0.01</linear><constant>0.2</constant><quadratic>0.002</quadratic></attenuation><cast_shadows>false</cast_shadows></light>

    <!-- === 3. WORLD STRUCTURE === -->
    
    <include>
      <uri>model://warehouse_ground</uri>
    </include>

    <!-- === LFR (Line Following Robot) PATHS === -->
    <!-- Black lines on the floor for LFR navigation -->
    <!-- Line thickness is 0.1m, height is 0.01m (to prevent z-fighting) -->

    <model name="lfr_line_north">
      <static>true</static>
      <pose>0 8 0.01 0 0 0</pose> <!-- Main N loop (X-axis) -->
      <link name="link">
        <collision name="collision"><geometry><box><size>37 0.1 0.005</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>37 0.1 0.005</size></box></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0 0 0 1</specular></material>
        </visual>
      </link>
    </model>

    <model name="lfr_line_south">
      <static>true</static>
      <pose>0 -8 0.01 0 0 0</pose> <!-- Main S loop (X-axis) -->
      <link name="link">
        <collision name="collision"><geometry><box><size>37 0.1 0.005</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>37 0.1 0.005</size></box></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0 0 0 1</specular></material>
        </visual>
      </link>
    </model>

    <model name="lfr_line_west">
      <static>true</static>
      <pose>-18.5 0 0.01 0 0 1.5707</pose> <!-- Main W loop (Y-axis) -->
      <link name="link">
        <collision name="collision"><geometry><box><size>16 0.1 0.005</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>16 0.1 0.005</size></box></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0 0 0 1</specular></material>
        </visual>
      </link>
    </model>

    <model name="lfr_line_east">
      <static>true</static>
      <pose>18.5 0 0.01 0 0 1.5707</pose> <!-- Main E loop (Y-axis) -->
      <link name="link">
        <collision name="collision"><geometry><box><size>16 0.1 0.005</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>16 0.1 0.005</size></box></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0 0 0 1</specular></material>
        </visual>
      </link>
    </model>

    <!-- Aisle Lines (Y-axis) -->
    <model name="lfr_line_aisle1">
      <static>true</static>
      <pose>-14.2 0 0.01 0 0 1.5707</pose> <!-- Aisle between L1 & L2 -->
      <link name="link">
        <collision name="collision"><geometry><box><size>16 0.1 0.005</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>16 0.1 0.005</size></box></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0 0 0 1</specular></material>
        </visual>
