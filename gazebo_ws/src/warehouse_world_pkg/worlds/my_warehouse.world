    <include><name>shelf_L2_F</name><uri>https://fuel.gazebosim.org/1.0/MovAi/models/shelf</uri><pose>-12.5 5 0 0 0 -1.57</pose></include>
    <include><name>shelf_L2_G</name><uri>https://fuel.gazebosim.org/1.0/MovAi/models/shelf</uri><pose>-12.5 0 0 0 0 -1.57</pose></include>
    <include><name>shelf_L2_H</name><uri>https://fuel.gazebosim.org/1.0/MovAi/models/shelf</uri><pose>-12.5 -5 0 0 0 -1.57</pose></include>
    <include><name>shelf_L3_A</name><uri>https://fuel.gazebosim.org/1.0/MovAi/models/shelf</uri><pose>-9.5 5 0 0 0 1.57</pose></include>
