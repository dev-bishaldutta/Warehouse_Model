              <!-- 
                *** YOUR CUSTOM IMAGE LOCATION 2 ***
                This is the "location" you asked for.
                Place your custom image (e.g., custom_south.png) 
                in a path that Gazebo can find (e.g., in a /materials/textures 
                folder relative to this world or in a custom model path).
                Then, update this URI to point to it.
                Example: file://media/materials/textures/custom_south.png
              -->
              <uri>model://warehouse_ground/materials/textures/images.png</uri>
              <name>Custom/ScreenSouth</name>
            </script>
            <!-- Make the screen glow slightly so it looks active -->
            <emissive>0.5 0.5 0.5 1</emissive>
          </material>
        </visual>
      </link>
    </model>

