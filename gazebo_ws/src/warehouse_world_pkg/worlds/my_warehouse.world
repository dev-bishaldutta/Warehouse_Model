        <visual name="visual">
          <geometry><box><size>16 0.1 0.005</size></box></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0 0 0 1</specular></material>
        </visual>
      </link>
    </model>

    <!-- NEW LFR Lines for inner aisles (between back-to-back shelves) -->
    <model name="lfr_line_aisle_L1">
      <static>true</static>
      <pose>-16.6 0 0.01 0 0 1.5707</pose> <!-- Inner aisle for L1 shelves -->
      <link name="link">
        <collision name="collision"><geometry><box><size>16 0.1 0.005</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>16 0.1 0.005</size></box></geometry>
