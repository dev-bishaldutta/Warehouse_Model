    <!-- === END LFR PATHS === -->

    <!-- Walls (All 6m high) -->
    <model name="north_wall"><static>true</static><pose>0 15 3.0 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>40 0.5 6</size></box></geometry></collision><visual name="visual"><geometry><box><size>40 0.5 6</size></box></geometry><material><ambient>0.7 0.7 0.6 1</ambient><diffuse>0.7 0.7 0.6 1</diffuse></material></visual></link></model>
    <model name="south_wall"><static>true</static><pose>0 -15 3.0 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>40 0.5 6</size></box></geometry></collision><visual name="visual"><geometry><box><size>40 0.5 6</size></box></geometry><material><ambient>0.7 0.7 0.6 1</ambient><diffuse>0.7 0.7 0.6 1</diffuse></material></visual></link></model>
    <model name="east_wall"><static>true</static><pose>20 0 3.0 0 0 1.57</pose><link name="link"><collision name="collision"><geometry><box><size>30 0.5 6</size></box></geometry></collision><visual name="visual"><geometry><box><size>30 0.5 6</size></box></geometry><material><ambient>0.7 0.7 0.6 1</ambient><diffuse>0.7 0.7 0.6 1</diffuse></material></visual></link></model>
    <model name="west_wall"><static>true</static><pose>-20 0 3.0 0 0 1.57</pose><link name="link"><collision name="collision"><geometry><box><size>30 0.5 6</size></box></geometry></collision><visual name="visual"><geometry><box><size>30 0.5 6</size></box></geometry><material><ambient>0.7 0.7 0.6 1</ambient><diffuse>0.7 0.7 0.6 1</diffuse></material></visual></link></model>


    <!-- Sloped Roof Panels (White) - Raised 1m -->
    <model name="roof_slope_east"> 
      <static>true</static>
      <!-- Panel covering positive X side. Center at z=7 -->
      <pose>10 0 7 0 0.0997 0</pose> 
      <link name="link">
        <collision name="collision">
          <geometry><box><size>20.1 30 0.1</size></box></geometry> 
        </collision>
        <visual name="visual">
          <geometry><box><size>20.1 30 0.1</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="roof_slope_west"> 
      <static>true</static>
      <!-- Panel covering negative X side. Center at z=7 -->
      <pose>-10 0 7 0 -0.0997 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>20.1 30 0.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>20.1 30 0.1</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>
    </model>


