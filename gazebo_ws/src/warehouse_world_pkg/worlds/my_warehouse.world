    </model>

    <model name="lfr_line_aisle3_main">
      <static>true</static>
      <pose>0 0 0.01 0 0 1.5707</pose> <!-- Central Aisle -->
      <link name="link">
        <collision name="collision"><geometry><box><size>16 0.1 0.005</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>16 0.1 0.005</size></box></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0 0 0 1</specular></material>
        </visual>
      </link>
    </model>

    <model name="lfr_line_aisle4">
      <static>true</static>
      <pose>9.4 0 0.01 0 0 1.5707</pose> <!-- Aisle between R1 & R2 -->
      <link name="link">
        <collision name="collision"><geometry><box><size>16 0.1 0.005</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>16 0.1 0.005</size></box></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0 0 0 1</specular></material>
        </visual>
