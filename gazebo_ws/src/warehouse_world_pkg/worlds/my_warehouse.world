        </visual>
      </link>
    </model>

    <!-- Spurs to South conveyor/pallet area -->
    <model name="lfr_line_conveyor_spur">
      <static>true</static>
      <pose>0 -10.5 0.01 0 0 1.5707</pose> <!-- Spur from S-loop (y=-8) to y=-13 -->
      <link name="link">
        <collision name="collision"><geometry><box><size>5 0.1 0.005</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>5 0.1 0.005</size></box></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0 0 0 1</specular></material>
        </visual>
      </link>
    </model>

    <model name="lfr_line_pallet_spur">
      <static>true</static>
      <pose>-5 -11 0.01 0 0 1.5707</pose> <!-- Spur from S-loop (y=-8) to y=-14 -->
      <link name="link">
        <collision name="collision"><geometry><box><size>6 0.1 0.005</size></box></geometry></collision>
        <visual name="visual">
